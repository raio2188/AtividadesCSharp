@model IEnumerable<Produto>
@{
    ViewData["Title"] = "Produtos";
}
<div class="cabecalho-lista">
    <h1>Produtos</h1><a asp-action="Create" class="btn btn-primary">Novo produto</a>
</div>
<form method="get" class="d-flex gap-2 mb-4"><input name="busca" value="@ViewBag.Busca" class="form-control"
                                                        placeholder="Buscar pelo nome" aria-label="Buscar produto" /><button class="btn btn-primary">Buscar</button>
</form>
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Ativo</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Categoria?.Nome</td>
                    <td>@item.Preco.ToString("C")</td>
                    <td>@item.Estoque</td>
                    <td>@(item.Ativo ? "Sim" : "Não")</td>
                    <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a> <a
                        asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>    </table>
    </div>