@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var acao = ViewContext.RouteData.Values["action"]?.ToString();
    var pagina = ViewContext.RouteData.Values["page"]?.ToString();
    var leitura = pagina is not null && !pagina.StartsWith("/Account/Manage/", StringComparison.Ordinal)
        || controlador == "Home" && acao is "Privacy" or "Error" or "Erro";
    var gestao = User.IsInRole("Admin") && (controlador == "Categorias" || controlador == "Produtos" || (controlador == "Pedidos" && acao == "Gestao"));
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Nexo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/loja.css" asp-append-version="true" />
</head>
<body data-bs-theme="dark">
<a class="pular" href="#conteudo">Pular para o conteúdo</a>
<header class="topo">
    <nav class="container d-flex flex-wrap align-items-center gap-3 py-3" aria-label="Navegação principal">
        <a class="marca" asp-controller="Home" asp-action="Index">Nexo</a>
        <a asp-controller="Home" asp-action="Index" class="link-menu" aria-current="@(controlador == "Home" && acao == "Index" ? "page" : null)">Produtos</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Pedidos" asp-action="Index" class="link-menu" aria-current="@(controlador == "Pedidos" && acao == "Index" ? "page" : null)">Meus pedidos</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Produtos" asp-action="Index" class="link-menu">Administrar</a>
        }
        <div class="ms-auto d-flex flex-wrap align-items-center gap-2"><partial name="_LoginPartial" /></div>
    </nav>
</header>
<div class="@(gestao ? "estrutura-admin" : "container py-4")">
    @if (gestao)
    {
        <aside class="menu-admin" aria-label="Administração">
            <h2 class="h4 mb-4">Admin</h2>
            <a asp-controller="Produtos" asp-action="Index" aria-current="@(controlador == "Produtos" ? "true" : null)">Produtos</a>
            <a asp-controller="Categorias" asp-action="Index" aria-current="@(controlador == "Categorias" ? "true" : null)">Categorias</a>
            <a asp-controller="Pedidos" asp-action="Gestao" aria-current="@(controlador == "Pedidos" ? "page" : null)">Pedidos</a>
            <a asp-controller="Home" asp-action="Index">Ver loja</a>
        </aside>
    }
    <main id="conteudo" tabindex="-1" class="@(gestao ? "conteudo-admin" : leitura ? "leitura" : null)">
        @if (TempData["Mensagem"] is string mensagem)
        {
            <div class="alert alert-info" role="status">@mensagem</div>
        }
        @RenderBody()
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
