@model techStoreMVC.Models.Produtos

@{
    ViewData[index: "Title"] = "Detalhes do Produtos";
}
<h1>
    Lista de Produtos
</h1>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>

    <dt class="col-sm-2">Preço</dt>
    <dd class="col-sm-10">@Model.Preco</dd>

    <dt class="col-sm-2">Estoque</dt>
    <dd class="col-sm-10">@Model.Estoque</dd>
</dl>
    
<a asp-action="Edit"
    asp-route-id="@Model.Id"
    class="btn btn-warning">
    Editar
</a>

<a asp-action="Index"
    asp-route-id="@Model.Id"
    class="btn btn-warning">
    Voltar
</a>

<a asp-action="Delete"
    asp-route-id="@Model.Id"
    class="btn btn-danger">
    Excluir
</a>